# Copy these into your hosting provider's environment settings (or export them before `node server.js`).
# Everything is optional for local webcam use.

PORT=3000

# The public https:// address of this app. Phone links and the QR code use it.
# Leave empty if you open the app through that same address already.
PUBLIC_URL=https://your-garden.example.com

# Set to 1 when running behind a proxy/host that sets X-Forwarded-For (Render, Railway, Fly, Cloudflare...).
# Needed so the wrong-PIN rate limit sees each visitor's real IP.
TRUST_PROXY=1

# --- TURN relay (recommended for office/corporate networks) --------------
# Option A: fixed credentials from your TURN provider
# TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349
# TURN_USERNAME=your-username
# TURN_CREDENTIAL=your-password
# Option B: coturn with use-auth-secret (time-limited credentials are generated for you)
# TURN_URLS=turn:turn.example.com:3478
# TURN_SECRET=your-shared-secret
# Option C: full control - a JSON array of RTCIceServer objects
# ICE_SERVERS_JSON=[{"urls":"stun:stun.l.google.com:19302"}]

# --- Optional: serve HTTPS directly (e.g. with a mkcert certificate) ------
# SSL_KEY=./certs/key.pem
# SSL_CERT=./certs/cert.pem
